# Run via `cmake -P` from md_gaia_pch(): builds <OBJ> (the codegen object of the gaia PCH) or takes it from a content-addressed cache.
# Inputs: CXX, RSP (response file with the compile flags), HDR, WORK (scratch dir), OBJ, DEPFILE, CACHE_DIR (cache dir, empty = no cache).
# The key is the hash of the preprocessed header + the flags + the compiler version, so an identical gaia / registry / flags state is never
# compiled twice (ccache cannot cache the `-c x.pch` step, which is 80 s per target).
file(MAKE_DIRECTORY "${WORK}")
if(DEFINED ENV{CCACHE_DISABLE})
    set(CACHE_DIR "")
endif()
execute_process(COMMAND "${CXX}" "@${RSP}" -E -x c++-header "${HDR}" -MD -MF "${DEPFILE}" -MT "${OBJ}"
                OUTPUT_FILE "${WORK}/gaia_pch.ii" RESULT_VARIABLE _r ERROR_VARIABLE _e)
if(NOT _r EQUAL 0)
    message(FATAL_ERROR "preprocess failed: ${_e}")
endif()
file(SHA256 "${WORK}/gaia_pch.ii" _ii)
file(READ "${RSP}" _flags)
execute_process(COMMAND "${CXX}" --version OUTPUT_VARIABLE _ver)
string(SHA256 _key "${_ii}|${_flags}|${_ver}")
if(CACHE_DIR AND EXISTS "${CACHE_DIR}/${_key}.o")
    file(COPY_FILE "${CACHE_DIR}/${_key}.o" "${OBJ}" ONLY_IF_DIFFERENT)
    message(STATUS "gaia codegen object: cache hit ${_key}")
    return()
endif()
execute_process(COMMAND "${CXX}" "@${RSP}" -x c++-header "${HDR}" -o "${WORK}/gaia_pch.pch" RESULT_VARIABLE _r ERROR_VARIABLE _e)
if(NOT _r EQUAL 0)
    message(FATAL_ERROR "pch build failed: ${_e}")
endif()
execute_process(COMMAND "${CXX}" "@${RSP}" -c "${WORK}/gaia_pch.pch" -o "${OBJ}" RESULT_VARIABLE _r ERROR_VARIABLE _e)
if(NOT _r EQUAL 0)
    message(FATAL_ERROR "pch object build failed: ${_e}")
endif()
if(CACHE_DIR)
    file(MAKE_DIRECTORY "${CACHE_DIR}")
    file(COPY_FILE "${OBJ}" "${CACHE_DIR}/${_key}.o" ONLY_IF_DIFFERENT)
endif()
