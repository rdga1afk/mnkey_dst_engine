# MonkeyDustEngineConfig.cmake -- generated by engine/CMakeLists.txt (install). #189: the engine and its static third-party libraries come prebuilt (CI, GitHub Release),
# the game / tools / tests compile only their own code. Imported targets: monkey_dust::engine (the same PUBLIC include paths and definitions as the in-tree target).
# Variant "@MD_ENGINE_VARIANT@", built from engine commit @MD_ENGINE_SHA@ with @MD_ENGINE_CXX_ID@ @MD_ENGINE_CXX_VERSION@, CMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@.
if(TARGET monkey_dust::engine)
    return()
endif()
include(CMakeFindDependencyMacro)
if(NOT TARGET SDL3::SDL3 AND NOT TARGET SDL3::SDL3-static)
    find_dependency(SDL3 CONFIG)
endif()

get_filename_component(_md_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(MonkeyDustEngine_SHA "@MD_ENGINE_SHA@")
set(MonkeyDustEngine_VARIANT "@MD_ENGINE_VARIANT@")
set(MonkeyDustEngine_FOUND TRUE)

if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "@MD_ENGINE_CXX_ID@")
    message(WARNING "[MonkeyDustEngine] built with @MD_ENGINE_CXX_ID@, the consumer uses ${CMAKE_CXX_COMPILER_ID}: the C++ ABI may differ")
elseif(NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@MD_ENGINE_CXX_VERSION@")
    message(STATUS "[MonkeyDustEngine] built with @MD_ENGINE_CXX_ID@ @MD_ENGINE_CXX_VERSION@, the consumer uses ${CMAKE_CXX_COMPILER_VERSION}")
endif()

foreach(_t Jolt ozz_animation ozz_animation_offline ozz_base)
    add_library(monkey_dust::${_t} STATIC IMPORTED)
endforeach()
set_target_properties(monkey_dust::Jolt PROPERTIES IMPORTED_LOCATION "${_md_prefix}/lib/@MD_ENGINE_FILE_Jolt@")
set_target_properties(monkey_dust::ozz_animation PROPERTIES IMPORTED_LOCATION "${_md_prefix}/lib/@MD_ENGINE_FILE_ozz_animation@")
set_target_properties(monkey_dust::ozz_animation_offline PROPERTIES IMPORTED_LOCATION "${_md_prefix}/lib/@MD_ENGINE_FILE_ozz_animation_offline@")
set_target_properties(monkey_dust::ozz_base PROPERTIES IMPORTED_LOCATION "${_md_prefix}/lib/@MD_ENGINE_FILE_ozz_base@")

if(TARGET SDL3::SDL3)
    set(_md_sdl SDL3::SDL3)
else()
    set(_md_sdl SDL3::SDL3-static)
endif()
add_library(monkey_dust::engine STATIC IMPORTED)
set(_md_inc
    "${_md_prefix}/include"
    "${_md_prefix}/include/third_party/ozz-animation"
    "${_md_prefix}/include/third_party/gaia-ecs"
    "${_md_prefix}/include/third_party/glm"
    "${_md_prefix}/include/third_party/JoltPhysics"
    "${_md_prefix}/include/vendor"
    "${_md_prefix}/include/audio")
set_target_properties(monkey_dust::engine PROPERTIES
    IMPORTED_LOCATION "${_md_prefix}/lib/libmonkey_dust_engine.a"
    INTERFACE_INCLUDE_DIRECTORIES "${_md_inc}"
    INTERFACE_COMPILE_DEFINITIONS "@MD_ENGINE_DEFS@"
    INTERFACE_COMPILE_OPTIONS "@MD_ENGINE_COPTS@"
    INTERFACE_LINK_OPTIONS "@MD_ENGINE_LOPTS@"
    INTERFACE_LINK_LIBRARIES "${_md_sdl};monkey_dust::Jolt;monkey_dust::ozz_animation_offline;monkey_dust::ozz_animation;monkey_dust::ozz_base;@MD_ENGINE_LUA@;dl")
unset(_md_inc)
unset(_md_sdl)

# #192: the MyGUI platform (monkey_dust_mygui), only when the package was built with MD_MYGUI=ON
if(EXISTS "${_md_prefix}/lib/libmonkey_dust_mygui.a")
    find_dependency(Freetype)
    add_library(monkey_dust::mygui STATIC IMPORTED)
    set_target_properties(monkey_dust::mygui PROPERTIES
        IMPORTED_LOCATION "${_md_prefix}/lib/libmonkey_dust_mygui.a"
        INTERFACE_INCLUDE_DIRECTORIES "${_md_prefix}/include/third_party/mygui"
        INTERFACE_COMPILE_DEFINITIONS "MYGUI_USE_FREETYPE;MYGUI_STATIC;MYGUI_BUILD;MYGUI_DONT_REPLACE_NULLPTR"
        INTERFACE_LINK_LIBRARIES "Freetype::Freetype;monkey_dust::engine")
endif()
